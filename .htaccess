# Aleph Printing & Graphics — Apache config for cPanel shared hosting

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# Canonical host: force HTTPS + non-www (single 301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# 301 redirects: legacy WordPress/WooCommerce URLs -> new site
# Preserves rankings & backlinks from the pre-2026 site. QSD drops
# old query strings (e.g. ?add-to-cart=, ?utm_source=).
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy shop: every product & category page -> new shop landing
  RewriteRule ^product/          /the-shop/ [R=301,L,QSD]
  RewriteRule ^product-category/ /the-shop/ [R=301,L,QSD]
  RewriteRule ^shop(/|$)         /the-shop/ [R=301,L,QSD]

  # Legacy contact pages (incl. Decypha backlink target) -> homepage
  RewriteRule ^home/contact/?$   / [R=301,L,QSD]
  RewriteRule ^get-in-touch/?$   / [R=301,L,QSD]
  RewriteRule ^en/contact/?$     / [R=301,L,QSD]

  # Legacy company pages -> closest new equivalent
  RewriteRule ^who-we-are/?$     / [R=301,L,QSD]
  RewriteRule ^what-we-do/?$     /the-printing-press/ [R=301,L,QSD]
  RewriteRule ^in-design/?$      /the-printing-press/ [R=301,L,QSD]
  RewriteRule ^o-carre/?$        /the-shop/ [R=301,L,QSD]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/ttf font/woff font/woff2
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType font/woff "access plus 30 days"
</IfModule>

# Keep code assets out of the index (images & favicons stay indexable for SEO)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
